<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <ImageView android:id="@+id/logo" android:layout_width="88dp" android:layout_height="88dp"
            android:layout_marginTop="24dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_logo_roadwatch"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/app_name" android:textSize="16sp"
            android:letterSpacing="0.12" android:textColor="@color/primary" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/brand_tagline" android:textSize="36sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/on_background"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/brand_description" android:textSize="16sp"
            android:lineSpacingExtra="4dp" android:textColor="@color/on_surface_variant"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/status_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/primary_container" app:cardElevation="0dp">
            <TextView android:id="@+id/status_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="20dp" android:text="@string/ready" android:textSize="16sp"
                android:textColor="@color/on_primary_container" android:lineSpacingExtra="4dp"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_start_drive"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
            android:layout_marginTop="20dp" android:text="@string/start_drive_mode" android:textSize="18sp" app:cornerRadius="20dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_stop_drive"
            style="@style/Widget.RoadWatch.Scope" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:text="@string/end_drive"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_open_settings"
            style="@style/Widget.RoadWatch.Scope" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/settings"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_field_test"
            style="@style/Widget.RoadWatch.Scope" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Field test &amp; send data"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/field_safety_note" android:textSize="13sp"
            android:lineSpacingExtra="3dp" android:textColor="@color/on_surface_variant"/>
        <TextView android:id="@+id/txt_version" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
