<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Hazard"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Hazard Type" />

    <Spinner
        android:id="@+id/spinner_hazard_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Who should be warned?" />

    <RadioGroup
        android:id="@+id/radio_group_directionality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/radio_one_way"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reported travel direction only" />

        <RadioButton
            android:id="@+id/radio_two_way"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Both travel directions (only if confirmed)" />
    </RadioGroup>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Travel heading at the hazard: 0 = North, 90 = East, 180 = South, 270 = West. On divided roads, check the side AND heading. Unknown headings are saved but do not warn."/>
    <EditText android:id="@+id/edt_hazard_heading" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="numberDecimal"
        android:hint="Travel heading (0 to less than 360)" android:importantForAutofill="no"/>
    <TextView
        android:id="@+id/txt_quick_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Quick actions"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_quick_opposite_lane"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mark_wrong_direction"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        app:cornerRadius="24dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_delete_hazard"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Delete hazard"
        android:textAllCaps="false"
        android:textColor="@android:color/holo_red_dark"
        android:visibility="gone"
        app:cornerRadius="24dp" />

</LinearLayout>
