<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/speed_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/drive_live" android:textColor="@color/primary"
                        android:textSize="12sp" android:letterSpacing="0.14" android:textStyle="bold"/>
                    <LinearLayout android:id="@+id/speed_card_content" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/txt_speed_value" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="2"
                            android:text="0" android:textSize="48sp" android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
                            android:textColor="@color/on_surface"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                            <TextView android:id="@+id/txt_bearing_value" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="--" android:textSize="24sp"
                                android:textColor="@color/on_surface" android:textStyle="bold"/>
                            <TextView android:id="@+id/txt_direction_label" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="@string/travel_heading"
                                android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/txt_speed_label" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="km/h" android:textColor="@color/on_surface_variant"/>
                    <TextView android:id="@+id/txt_next_subtitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textColor="@color/on_surface_variant" android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/mute_chip"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:layout_marginTop="8dp" app:cardCornerRadius="12dp">
                <TextView android:id="@+id/txt_muted_until" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/error"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/next_chip"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" app:cardCornerRadius="12dp" app:cardBackgroundColor="@color/primary_container">
                <TextView android:id="@+id/txt_next_hazard" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="12dp" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/on_primary_container"/>
            </com.google.android.material.card.MaterialCardView>
            <FrameLayout android:id="@+id/map_container" android:layout_width="match_parent"
                android:layout_height="180dp" android:layout_weight="1" android:layout_marginVertical="12dp"/>
            <LinearLayout android:id="@+id/hazard_buttons_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/report_scope_title" android:textStyle="bold" android:textSize="16sp"
                    android:textColor="@color/on_surface"/>
                <TextView android:id="@+id/txt_report_scope" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="@string/report_scope_one" android:textSize="13sp" android:textColor="@color/on_surface_variant"/>
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggle_report_dir"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_dir_one"
                        style="@style/Widget.RoadWatch.Scope" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/scope_this"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_dir_both"
                        style="@style/Widget.RoadWatch.Scope" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/scope_both"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_report_bump"
                        style="@style/Widget.RoadWatch.Report" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="8dp" android:text="@string/speed_bump" app:icon="@drawable/ic_hazard_bump"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_report_pothole"
                        style="@style/Widget.RoadWatch.Report" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/pothole" app:icon="@drawable/ic_hazard_pothole"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_report_rumble"
                        style="@style/Widget.RoadWatch.Report" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="8dp" android:text="@string/rumble_strip" app:icon="@drawable/ic_hazard_rumble_strip"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_report_zone"
                        style="@style/Widget.RoadWatch.Report" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/speed_zone" app:icon="@drawable/ic_add"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/bottom_bar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_stop"
                    style="@style/Widget.RoadWatch.Scope" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="8dp" android:text="@string/end_drive"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_mute"
                    style="@style/Widget.RoadWatch.Scope" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mute_alerts_short"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/alert_overlay"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:visibility="gone" app:cardCornerRadius="24dp" app:cardElevation="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/alert_text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold"
                android:textColor="@android:color/black"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_alert_wrong"
                style="@style/Widget.RoadWatch.Scope" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/wrong_alert"
                android:textColor="@android:color/black"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
