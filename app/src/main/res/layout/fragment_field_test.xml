<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        android:title="Field test" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Try it parked, then check it on the road. Every drive is recorded on this phone so problems can be found and fixed."
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_simulate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Run a simulated drive (about 1 minute)" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="First alert comes after about 20 seconds. Switch to Google Maps, YouTube or your music app and lock/unlock the screen to confirm the voice, vibration and banner show over them."
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Review a trip"
                android:textSize="18sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spn_trips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/txt_trip_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No trips yet. Start Drive Mode and go for a drive." />
            <LinearLayout
                android:id="@+id/alert_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Send field data (zip)" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Packs recent trips and your hazards into one file you can share by Google Drive, WhatsApp or email."
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
